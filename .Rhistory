panel <- read_csv("data/panel_remittances_pga.csv")
# PARALLEL TRENDS ASSUMPTION
# define 'ever-treated' municipalities
ever_treated <- panel %>%
group_by(state, municipality) %>%
summarise(ever_treated = max(mean_pga, na.rm = TRUE) > 5,
.groups = "drop")
# plot
panel %>%
left_join(ever_treated, by = c("state", "municipality")) %>%
mutate(treated = ifelse(ever_treated, "Ever Treated", "Never Treated")) %>%
group_by(year, quarter, treated) %>%
summarise(avg_remit = mean(remittances_musd, na.rm = TRUE), .groups = "drop") %>%
mutate(time = year + (quarter - 1) / 4) %>%
ggplot(aes(x = time, y = avg_remit, color = treated)) +
geom_line() +
geom_vline(xintercept = 2017.5, color = "red", linetype = "dashed") +
labs(title = "Remittances: ever-treated vs never-treated municipalities",
x = "Year", y = "Avg remittances (M USD)")+
theme_bw()+
theme(plot.title = element_text(hjust = 0.5))
# notes:
# - parallel trends seems to hold
# - but no obvious divergence; makes sense as we are looking at the whole picture; at the aggregate level
#     - i.e. this averages across all treated municipalities regardless of PGA intensity
# - would expect DiD regression to be much more precise; PGA will be used as a continuous variable
# For a given earthquake quarter (e.g. 2017 Q3)
pga_vector <- panel %>%
filter(year == 2017, quarter == 3) %>%
arrange(paste(state, municipality, sep = "_")) %>%
pull(mean_pga)
neighbor_pga_network <- W_network %*% pga_vector
dim(W_network)      # should be (n x n)
length(pga_vector)  # should be same n
head(rownames(W_network), 10)
panel_filtered %>%
mutate(label = paste(state, municipality, sep = "_")) %>%
pull(label) %>%
head(10)
View(panel)
pga_vector <- panel %>%
filter(year == 2017, quarter == 3) %>%
mutate(label = paste(state, municipality, sep = "_")) %>%
arrange(label) %>%
pull(mean_pga)
network_labels <- rownames(W_network)
panel_labels <- panel %>%
distinct(state, municipality) %>%
mutate(label = paste(state, municipality, sep = "_")) %>%
pull(label)
length(intersect(network_labels, panel_labels))
library(stringi)
panel_labels_clean <- stri_trans_general(panel_labels, "Latin-ASCII")
length(intersect(network_labels, panel_labels_clean))
unmatched_labels <- setdiff(panel_labels_clean, network_labels)
head(unmatched_labels, 20)
# Convert panel labels to title case after stripping accents
panel_labels_clean <- panel %>%
distinct(state, municipality) %>%
mutate(
state_clean = stri_trans_general(state, "Latin-ASCII"),
muni_clean  = stri_trans_general(municipality, "Latin-ASCII"),
muni_clean  = str_to_title(muni_clean),
label_clean = paste(state_clean, muni_clean, sep = "_")
) %>%
pull(label_clean)
length(intersect(panel_labels_clean, network_labels))
unmatched_labels <- setdiff(panel_labels_clean, network_labels)
head(unmatched_labels, 20)
network_labels[startsWith(network_labels, "Distrito")]  %>% head(5)
network_labels[startsWith(network_labels, "Mexico") |
startsWith(network_labels, "Estado")] %>% head(5)
panel_labels_clean <- panel_filtered %>%
distinct(state, municipality) %>%
mutate(
state_clean = stri_trans_general(state, "Latin-ASCII"),
muni_clean  = stri_trans_general(municipality, "Latin-ASCII"),
muni_clean  = str_to_title(muni_clean),
state_clean = case_when(
state_clean == "Mexico" ~ "Estado De Mexico",
TRUE                    ~ state_clean
),
label_clean = paste(state_clean, muni_clean, sep = "_")
) %>%
pull(label_clean)
length(intersect(panel_labels_clean, network_labels))
# Get common municipalities
common_munis <- intersect(panel_labels_clean, network_labels)
cat("Common municipalities:", length(common_munis), "\n")
# Build lookup table: panel label → clean label
panel_lookup <- panel %>%
distinct(state, municipality) %>%
mutate(
state_clean = stri_trans_general(state, "Latin-ASCII"),
muni_clean  = stri_trans_general(municipality, "Latin-ASCII"),
muni_clean  = str_to_title(muni_clean),
state_clean = case_when(
state_clean == "Mexico" ~ "Estado De Mexico",
TRUE                    ~ state_clean
),
label_clean = paste(state_clean, muni_clean, sep = "_")
)
# Subset W_network to common municipalities
W_network_aligned <- W_network[common_munis, common_munis]
W_network_aligned <- W_network_aligned / rowSums(W_network_aligned)
# Build pga_vector in same order as W_network_aligned
pga_vector <- panel_lookup %>%
filter(label_clean %in% common_munis) %>%
left_join(
panel %>% filter(year == 2017, quarter == 3),
by = c("state", "municipality")
) %>%
arrange(match(label_clean, common_munis)) %>%
pull(mean_pga)
# Compute spatial lag
neighbor_pga_network <- W_network_aligned %*% pga_vector
dim(neighbor_pga_network)
